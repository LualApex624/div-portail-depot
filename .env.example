# ---------------------------------------------------------------------------
# Portail de depot de pieces — variables d'environnement
#
# Ce fichier est un modele SANS VALEUR SECRETE, versionne. Le fichier .env
# reel est genere par ./install.sh (secrets tires par openssl) et n'est jamais
# commite : il est ignore par .gitignore.
#
#   Regenerer un secret a la main :  openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Origines publiques ----------------------------------------------------
# Point d'entree unique du portail (Nginx). Front et API partagent l'origine,
# ce qui evite toute preflight CORS et garde les cookies same-site.
PUBLIC_ORIGIN=http://localhost:8080

# Origine du stockage objet, telle que vue par le NAVIGATEUR du client : c'est
# l'hote signe dans les URLs presignees, il doit correspondre exactement.
STORAGE_PUBLIC_ORIGIN=http://localhost:3900

# --- Ports publies (127.0.0.1 uniquement) ----------------------------------
HTTP_PORT=8080
API_PORT=4000
WEB_PORT=3000
POSTGRES_PORT=5434
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# --- Base de donnees -------------------------------------------------------
POSTGRES_USER=div
POSTGRES_PASSWORD=
POSTGRES_DB=div_depot

# --- Secrets applicatifs (openssl rand -hex 32) ----------------------------
# Pepper des empreintes HMAC des tokens et des sessions. Vit hors base : si le
# dump SQL fuit sans lui, les empreintes ne permettent pas de retrouver les
# tokens.
SERVER_PEPPER=
# Sel du hachage des IP dans le journal d'audit (pseudonymisation RGPD).
AUDIT_IP_SALT=

# --- Stockage objet (Garage) ----------------------------------------------
S3_BUCKET=div-deposits
S3_ACCESS_KEY=
S3_SECRET_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# --- Politique de securite -------------------------------------------------
# true des que le portail est servi en HTTPS. Faux en local sur http://.
COOKIE_SECURE=false
AUTH_SESSION_TTL_HOURS=8
DEPOSIT_SESSION_TTL_MINUTES=30
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# --- Politique de depot ----------------------------------------------------
MAX_FILE_SIZE_BYTES=26214400
MAX_FILES_PER_REQUEST=10
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
PRESIGN_PUT_TTL_SECONDS=300
PRESIGN_GET_TTL_SECONDS=60

# --- Purge -----------------------------------------------------------------
# Cron a 6 champs (secondes en tete). Par defaut : toutes les minutes.
REAPER_CRON="0 * * * * *"
REAPER_ENABLED=true

# --- Observabilite ---------------------------------------------------------
LOG_LEVEL=info
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# --- Compte de demonstration ----------------------------------------------
SEED_DEMO_PASSWORD=

# --- Registre d'images -----------------------------------------------------
# En local, install.sh construit ces images sous le tag `local`.
# Pour un deploiement serveur (`./install.sh --pull`), pointer vers le registre
# et un tag publie — le nom du depot doit etre entierement en minuscules :
#   REGISTRY_IMAGE_API=ghcr.io/mon-compte/div-portail-depot-api
#   REGISTRY_IMAGE_WEB=ghcr.io/mon-compte/div-portail-depot-web
#   IMAGE_TAG=v1.0.0
REGISTRY_IMAGE_API=div-portail-depot/api
REGISTRY_IMAGE_WEB=div-portail-depot/web
IMAGE_TAG=local
