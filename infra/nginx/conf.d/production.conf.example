# ---------------------------------------------------------------------------
# Configuration de production — HTTPS reel via Let's Encrypt.
#
# NON ACTIVE par defaut : ce rendu est concu pour tourner en local, ou une
# autorite de certification publique ne peut rien signer pour "localhost".
#
# Pour l'activer sur le sous-domaine fourni :
#   1. cp production.conf.example production.conf
#   2. remplacer VOTRE-SOUS-DOMAINE par le sous-domaine reel
#   3. ../setup-letsencrypt.sh VOTRE-SOUS-DOMAINE contact@exemple.fr
#   4. dans .env : PUBLIC_ORIGIN=https://VOTRE-SOUS-DOMAINE
#                  STORAGE_PUBLIC_ORIGIN=https://VOTRE-SOUS-DOMAINE/storage
#                  COOKIE_SECURE=true
#   5. ./install.sh --pull   (le serveur tire l'image, il ne compile pas)
#
# Rappel du routage impose par l'enonce : le proxy frontal de la machine
# occupe deja 80 et 443. Il route le port 80 par en-tete Host et fait du
# passthrough TLS par SNI sur 443 vers NOTRE port. C'est donc bien ce nginx-ci
# qui termine TLS, avec notre propre certificat.
# ---------------------------------------------------------------------------

upstream div_api      { server api:4000; }
upstream div_web      { server web:3000; }
upstream div_storage  { server garage:3900; }

# Le challenge http-01 arrive en clair sur le port 80, via le proxy frontal.
server {
    listen 80;
    server_name VOTRE-SOUS-DOMAINE;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name VOTRE-SOUS-DOMAINE;

    ssl_certificate     /etc/letsencrypt/live/VOTRE-SOUS-DOMAINE/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/VOTRE-SOUS-DOMAINE/privkey.pem;

    # TLS 1.2 minimum, 1.3 privilegie.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling on;
    ssl_stapling_verify on;

    client_max_body_size 26m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    # Le stockage objet passe par le meme certificat et le meme hote.
    #
    # C'est indispensable en HTTPS : une page servie en https ne peut pas
    # televerser vers un http://garage:3900 (contenu mixte bloque par le
    # navigateur). `proxy_set_header Host $host` est obligatoire ici — la
    # signature SigV4 couvre l'en-tete Host, et l'URL a ete signee pour ce
    # nom de domaine.
    location /storage/ {
        proxy_pass http://div_storage/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        client_max_body_size 26m;
    }

    location /api/ {
        proxy_pass http://div_api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/metrics {
        deny all;
        return 404;
    }

    location / {
        proxy_pass http://div_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
